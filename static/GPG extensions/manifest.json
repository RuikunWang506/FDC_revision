{
  "manifest_version": 3,
  "name": "GPG Invoice Extension",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.fdcef.com/*",
    "https://admin.genuinepartsgiant.com/popup/HPD/orderDetails/*",
    "https://admin.genuinepartsgiant.com/popup/HPN/orderDetails/*",
	  "https://admin.genuinepartsgiant.com/popup/TPD/orderDetails/*",
    "https://admin.genuinepartsgiant.com/popup/APW/orderDetails/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": [
      "https://admin.genuinepartsgiant.com/popup/HPD/orderDetails/*",
      "https://admin.genuinepartsgiant.com/popup/HPN/orderDetails/*",
	    "https://admin.genuinepartsgiant.com/popup/TPD/orderDetails/*",
      "https://admin.genuinepartsgiant.com/popup/APW/orderDetails/*"
    ],
    "js": ["content.js"]
  }]
}
